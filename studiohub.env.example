# studiohub.env 로 복사해 채운다 (git 제외). 같은 키의 환경 변수가 있으면 그게 우선.
IMMICH_URL=http://localhost:2283
IMMICH_API_KEY=            # Immich 웹 → 계정 설정 → API 키
APPFLOWY_URL=http://localhost:8070
APPFLOWY_EMAIL=            # AppFlowy 일반 계정 (시스템 관리자 계정은 워크스페이스가 없다)
APPFLOWY_PASSWORD=
APPFLOWY_WORKSPACE=        # 비우면 첫 워크스페이스. 이름 또는 id
# STUDIOHUB_ASSETS_REGISTRY=./registry.json      # 자산 레지스트리 (README)
# STUDIOHUB_STATE_DIR=./.state                   # 동기화 장부·토큰 캐시
# STUDIOHUB_VAULT=./vault                        # 지시 로그 <vault>/10_PROJECTS/<project>.directives.md
# STUDIOHUB_DEX_DATA=../my-game/packages/shared/src/data   # 도감 프로필이 읽는 게임 데이터
# APPFLOWY_ENV_FILE=./local-services/appflowy/AppFlowy-Cloud/.env   # login-link 가 읽는 GOTRUE_JWT_SECRET
